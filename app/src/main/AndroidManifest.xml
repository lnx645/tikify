<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".TikTokSoundApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_legacy"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_legacy"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.TikTokSoundAlert"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.TikTokSoundAlert.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TikTokSoundAlert" />

        <activity
            android:name=".ui.SettingsActivity"
            android:theme="@style/Theme.TikTokSoundAlertToolbar"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.AccountsActivity"
            android:theme="@style/Theme.TikTokSoundAlertToolbarNoActionBar"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.WordListActivity"
            android:theme="@style/Theme.TikTokSoundAlertToolbar"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.SoundLibraryActivity"
            android:theme="@style/Theme.TikTokSoundAlertToolbar"
            android:parentActivityName=".ui.MainActivity" />

        <service
            android:name=".service.TikTokService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />

    </application>
</manifest>
