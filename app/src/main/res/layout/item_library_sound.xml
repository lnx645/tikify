<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/tv_lib_avatar"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_avatar_circle"
        android:gravity="center"
        android:text="M"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_lib_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:text="Sound Name"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle2" />

        <TextView
            android:id="@+id/tv_lib_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MyInstants"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_lib_select"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pilih" />

    <ImageView
        android:id="@+id/iv_lib_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="Preview sound"
        android:padding="12dp"
        android:src="@drawable/ic_play"
        app:tint="@color/primary" />
</LinearLayout>